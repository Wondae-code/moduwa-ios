<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  개인정보 매니페스트 — 앱이 무엇을 모으고, 사유가 필요한 API 를 왜 쓰는지 애플에 신고한다.

  ⚠️ **앱스토어 개인정보 표시(App Privacy)와 같은 말을 해야 한다.** 여기와 App Store Connect
     답변이 어긋나면 심사에서 걸린다. 서버가 실제로 저장하는 것을 기준으로 적었고,
     근거는 https://moduwa.app/privacy 의 "1. 수집하는 개인정보 항목" 표와 같다.

  ⚠️ 서드파티 SDK 는 **각자 매니페스트를 갖는다** — 이 파일이 대신하지 못한다.
     빌드 결과에서 확인함(2026-09-05): Alamofire, KakaoSDKCommon, KakaoMapsSDK 모두 포함.
     구글 로그인은 SDK 를 쓰지 않는다(`GoogleSignInFlow` 가 ASWebAuthenticationSession 직접 사용).

  ⚠️ **적지 않은 것들**(적을 이유가 없다는 근거):
     - 위치: 수집하지 않는다. 위치 권한 키 자체가 Info.plist 에 없다.
     - 검색 기록: 서버가 저장하지 않는다(실시간 처리만 — 저장 테이블·insert 없음).
     - 광고·추적: 식별자를 쓰지 않고 ATT 를 띄우지 않는다.
     - 크래시·분석: 그런 SDK 가 없다(의존성은 Alamofire·Kakao 둘뿐).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults — 로그인 유지 여부·온보딩 값·접근성 설정(글자 크기·고대비·읽어주기
		     속도)·민감정보 동의 기록을 이 앱 안에서만 읽고 쓴다. 다른 앱·기기와 공유하지 않으므로
		     사유는 CA92.1(같은 앱의 정보 접근)이다. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- 이메일 — 계정의 식별자. 소셜 로그인은 제공자에게서 전달받는다. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- 이름 — 애플 로그인에서 `fullName` 을 받아 닉네임 초기값으로 쓴다(첫 로그인에만 온다). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- 사용자 ID — 닉네임(글에 표시되는 이름)과 계정 uuid. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- 민감정보 — 무장애 항목(휠체어·시각·청각·유아·고령자)은 애플이 말하는 Sensitive Info
		     정의에 **장애(disability)** 로 명시돼 있다. 선택 항목이고 **별도 동의를 받은 뒤에만**
		     서버로 나간다(`SensitiveConsentStore`, 가입 화면의 세 번째 동의 줄).

		     ⚠️ 목적이 **둘**이다. 이 값은 계정에 저장될 뿐 아니라 홈 추천 목록을 좁히는 데
		     쓰인다(`fetchRecommendedPlaces(accessFeatures:)` → `access=`). 애플이 말하는
		     "제품 개인화"의 정의가 그대로 이것이라, 앱 기능만 적으면 사실과 다르다. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSensitiveInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
			</array>
		</dict>

		<!-- 사진 — 프로필 사진과 후기·게시글에 첨부한 사진. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- 사용자 작성물 — 게시글·후기·댓글·여행 플랜. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- 기기 ID — 푸시 알림 토큰과 작성자 식별용 기기 uuid(`reviewAuthorDeviceId`).
		     광고 식별자가 아니고 추적에 쓰지 않는다. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- 이용 기록 — 저장한 장소·좋아요·차단·신고. 애플의 Product Interaction 정의에
		     "saved place in a map" 이 그대로 들어 있다. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
