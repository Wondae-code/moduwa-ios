<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MODUWA_API_KEY</key>
	<string>mdw_발급받은_키를_여기에</string>
	<key>KAKAO_NATIVE_APP_KEY</key>
	<string>카카오디벨로퍼스_네이티브_앱_키</string>
	<!-- 구글 로그인. Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID → iOS,
	     번들 ID com.waasegye.moduwa 로 발급.
	     ⚠️ 이 값의 역방향(com.googleusercontent.apps.…)을 moduwa/Info.plist 의
	        CFBundleURLSchemes 에도 등록해야 로그인 후 앱으로 돌아온다.
	     ⚠️ 서버에도 같은 값을 GOOGLE_CLIENT_IDS 로 넣어야 한다(토큰의 aud 검증). -->
	<key>GOOGLE_IOS_CLIENT_ID</key>
	<string>숫자-문자열.apps.googleusercontent.com</string>
</dict>
</plist>
